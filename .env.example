APP_NAME="KAML KAMAL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# SQLite concurrency (Laravel applies these as PRAGMA on connect)
DB_BUSY_TIMEOUT=20000
DB_JOURNAL_MODE=wal
DB_SYNCHRONOUS=NORMAL

# Prefer file drivers when DB_CONNECTION=sqlite so session/cache writes do not
# contend with app data in the same database.sqlite (reduces lock / corruption risk).
# Keep SESSION_DRIVER=database / CACHE_STORE=database only with MySQL/MariaDB/Redis.
SESSION_DRIVER=file
SESSION_LIFETIME=525600

# Sanctum API token lifetime in minutes (525600 ≈ 365 days)
SANCTUM_EXPIRATION=525600
# Throttle last_used_at UPDATEs (seconds). Set SANCTUM_LAST_USED_AT=false to disable writes.
# On SQLite, writes are skipped entirely by default (SANCTUM_SKIP_LAST_USED_AT_ON_SQLITE=true).
SANCTUM_LAST_USED_AT=true
SANCTUM_LAST_USED_AT_THROTTLE=3600
SANCTUM_SKIP_LAST_USED_AT_ON_SQLITE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync avoids jobs table writers on SQLite when there is no dedicated queue worker.
# Use database/redis only if a queue:work process is always running.
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

VINSTACK_API_URL=https://app.vinstack.com/api/v1/client
VINSTACK_API_TOKEN=

# Apibara Vehicle Auction Data API (server-side only — never expose to Vite/Vue)
APIBARA_API_KEY=
APIBARA_BASE_URL=https://apibara.tech/api/v1/vehicle-auction
APIBARA_TIMEOUT=30
APIBARA_CACHE_ENABLED=true
APIBARA_CACHE_TTL=86400
APIBARA_MAX_PER_PAGE=10
APIBARA_MONTHLY_FREE_QUOTA=100

# Cloudinary (container ZIP images — optional; can also configure in Admin → Settings)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=vinstack/containers
